# Managed by Ansible (roles/gateway): http-level gateway config.

##
# cozy cache
##
proxy_cache_path /var/cache/nginx keys_zone=cozy_zone:64m;

##
# cozy limit (per-ip `cozy_ip_limit` zone in nginx.conf)
##
limit_req_zone $server_name zone=cozy_global_limit:1m rate=1000r/s;

# websocket upgrades pass through; plain requests keep upstream keepalive
map $http_upgrade $gateway_ws_connection {
    default upgrade;
    ''      '';
}

##
# upstream failover for every proxied location
##
proxy_connect_timeout {{ gateway_upstream_connect_timeout }};
proxy_next_upstream {{ gateway_proxy_next_upstream }};
