# Managed by Ansible (roles/gateway)
user www-data;
worker_processes auto;
worker_cpu_affinity auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

# every client and upstream connection is an fd, plus cache files and logs.
# systemd's default soft limit (1024) would otherwise cap connections first.
worker_rlimit_nofile {{ gateway_worker_connections * 2 }};

events {
    worker_connections {{ gateway_worker_connections }};
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ##
    # tls (mozilla "intermediate", ecdhe only so no dhparams needed)
    ##
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # websockets (spacedust) still gets http/1.1
    http2 on;

    ##
    # logs
    ##
    access_log /var/log/nginx/access.log;

    # parsed by prometheus-nginxlog-exporter, configured from the same var
    log_format exporter '{{ gateway_log_format }}';

    ##
    # gzip
    ##
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    ##
    # cozy cache
    ##
    proxy_cache_path /var/cache/nginx keys_zone=cozy_zone:64m;

    ##
    # cozy limit
    ##

    # v4 ip or v6 /64
    map $remote_addr $cozy_client_ip {
        # first four ipv6 groups (the /64)
        "~^(?<p>[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}):" $p;
        # if `::` shows within the first four groups, take the higher prefix
        "~^(?<p>[0-9a-f:]*?::)" $p;
        # should only be ipv4 beyond here
        default $binary_remote_addr;
    }
    limit_req_zone $cozy_client_ip zone=cozy_ip_limit:10m rate=50r/s;
    limit_req_zone $server_name zone=cozy_global_limit:1m rate=1000r/s;

    # websocket upgrades pass through; plain requests keep upstream keepalive
    map $http_upgrade $gateway_ws_connection {
        default upgrade;
        ''      '';
    }

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
