{# the upstream block for `site` (an entry of gateway_sites). tailnet ips, not
   names: nginx resolves names at startup and fails if tailscale isn't up. #}
upstream cozy_{{ site.log }} {
{% for up in site.upstreams %}
    server {{ hostvars[up.host].tailscale_ip }}:{{ site.upstream_port }}{{ ' backup' if up.backup | default(false) else '' }}; # {{ up.host }}
{% endfor %}
    keepalive 16;
}
