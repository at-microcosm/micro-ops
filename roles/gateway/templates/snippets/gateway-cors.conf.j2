# Managed by Ansible (roles/gateway): take over cors from the upstream.
# `always` applies the headers to error responses too.
#
# any add_header in a location drops *all* of the server block's add_headers,
# so include this again in every location that adds its own.
#
# note: the upstream's Access-Control-Allow-Methods isn't hidden, so preflight
# responses can carry both (carried over as-is from the old gateways).
proxy_hide_header 'Access-Control-Allow-Origin';
proxy_hide_header 'Access-Control-Allow-Headers';
add_header 'Access-Control-Allow-Origin' '*' always;
add_header 'Access-Control-Allow-Methods' 'GET' always;
add_header 'Access-Control-Allow-Headers' '*' always;
