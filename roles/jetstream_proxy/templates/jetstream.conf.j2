# Managed by Ansible (roles/jetstream_proxy)
upstream jetstream_app {
    server {{ jetstream_bind }};
    keepalive 16;
}

# websocket upgrades pass through; plain requests keep upstream keepalive
map $http_upgrade $jetstream_ws_connection {
    default upgrade;
    ''      '';
}

server {
    server_name {{ jetstream_public_host }};
    include snippets/tls-{{ jetstream_public_host }}.conf;
    include snippets/acme.conf;

    access_log /var/log/nginx/jetstream-access.log exporter;
    error_log /var/log/nginx/jetstream-error.log;

{% if jetstream_proxy_real_ip_from %}
{% for addr in jetstream_proxy_real_ip_from %}
    set_real_ip_from {{ addr }};
{% endfor %}

    real_ip_header X-Real-IP;
{% endif %}

    location / {
        proxy_pass http://jetstream_app;
        include snippets/proxy.conf;
        proxy_set_header Upgrade $http_upgrade; # websockets
        proxy_set_header Connection $jetstream_ws_connection;

        # filtered subscribers might be quiet for long periods
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
