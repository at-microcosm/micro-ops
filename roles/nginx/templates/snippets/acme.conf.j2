# Managed by Ansible (roles/nginx): acme http-01 challenges.
#
# forward acme challenges to peers if we have no answer
location /.well-known/acme-challenge/ {
    limit_req zone=cozy_ip_limit nodelay burst=150;
    root {{ nginx_acme_webroot }};
{% if nginx_acme_peers %}
    try_files $uri @acme_peers;
{% else %}
    try_files $uri =404;
{% endif %}
}
{% if nginx_acme_peers %}

# not here: a peer probably requested this token
location @acme_peers {
    proxy_pass http://acme_peers;
    proxy_cache off; # don't let a site's cache hold on to a miss
    proxy_next_upstream error timeout http_404; # ask the next peer on a miss
    proxy_connect_timeout 2s;
    proxy_read_timeout 2s;
}
{% endif %}
