# Managed by Ansible (roles/nginx): take over cors (over upstream).
#
# `always` applies headers to error responses.
#
# `add_header` in `location` drops all pervious `add_header`s from `server`
# block's, so this needs to be re-included in location blocks that add headers.

# for the moment we explicitly take over from upstream for cors
proxy_hide_header 'Access-Control-Allow-Origin';
proxy_hide_header 'Access-Control-Allow-Methods';
proxy_hide_header 'Access-Control-Allow-Headers';

# ...and apply a very permissive policy
add_header 'Access-Control-Allow-Origin' '*' always;
add_header 'Access-Control-Allow-Methods' '*' always;
add_header 'Access-Control-Allow-Headers' '*' always; # nb: does not include Authorization

add_header 'Access-Control-Max-Age' 86400; # bit longer
add_header 'Access-Control-Expose-Headers' '*'; # let JS apps read everything

if ($request_method = OPTIONS) { return 204; }
