# Managed by Ansible (roles/nginx_tls): locations for {{ nginx_tls_host }}.

{% if nginx_tls_root_redirect | default('') != '' %}
# redirect root-path requests to the hubble web ui, if configured
location = / {
    return 302 {{ nginx_tls_root_redirect }};
}
{% endif %}

location / {
    proxy_pass http://{{ nginx_tls_upstream }};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
