[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter --web.listen-address={{ node_exporter_listen }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
